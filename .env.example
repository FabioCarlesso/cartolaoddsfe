# URL do backend — padrão aponta para o host via host.docker.internal
# Funciona em Docker Desktop (Mac/Windows) e Linux (via extra_hosts no compose)
# Em produção, substitua pelo hostname/IP do container ou serviço backend
BACKEND_URL=http://host.docker.internal:8080

# Porta exposta no host para o frontend
APP_PORT=4200

# Permite ao container fixar, na subida, o IP de um BACKEND_URL cujo nome só
# exista no /etc/hosts — o caso do host.docker.internal acima. O
# docker-compose.yml já liga isso no desenvolvimento.
#
# NÃO defina em produção: lá o nome do backend precisa ser re-resolvido a cada
# requisição, porque o IP muda a cada deploy do backend.
# BACKEND_URL_FROM_ETC_HOSTS=1

# ── Uso com backend em compose ──────────────────────────────────────────────
# Se rodar o backend via docker-compose, use o nome do serviço:
# BACKEND_URL=http://backend:8080

# ── Uso em produção ──────────────────────────────────────────────────────────
# BACKEND_URL=https://api.meudominio.com
# APP_PORT=80
#
# Com o backend na rede privada da plataforma, use o hostname interno dela —
# o container re-resolve esse nome a cada 10s, então o IP novo de um redeploy
# do backend é seguido sozinho, sem reiniciar o frontend:
# BACKEND_URL=http://nome-do-servico.interno:8080
