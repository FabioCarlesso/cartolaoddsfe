server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compressão gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1024;

    # Headers de segurança para respostas geradas no nível server, antes de
    # qualquer location casar (400, 413, 414). Cada location abaixo declara
    # os seus próprios add_header e por isso não herda estes.
    include /etc/nginx/snippets/security-headers.conf;

    # A raiz é a landing pré-renderizada no build: o HTML já vem com o conteúdo,
    # e não com o <app-root> vazio.
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";

        # Headers de segurança (não são herdados do nível server pois este
        # location já define add_header Cache-Control)
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Demais rotas do Angular caem no shell vazio (`index.csr.html`), e não na
    # landing pré-renderizada: servir o index.html aqui faria quem abre /time
    # direto ver a landing piscar antes de a aplicação assumir a tela.
    location / {
        try_files $uri $uri/ /index.csr.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";

        # Headers de segurança (não são herdados do nível server pois este
        # location já define add_header Cache-Control)
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Assets estáticos — cache longo
    location ~* \.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;

        # Headers de segurança (não são herdados do nível server pois este
        # location já define add_header Cache-Control)
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Proxy reverso para o backend — repassa somente os headers de
    # segurança definidos pelo Spring Security, sem sobreposição do nginx
    #
    # `^~` e não um prefixo simples: com `^~` o nginx para a busca aqui e nem
    # chega a testar os `location` de regex declarados acima, então um
    # `/api/algo.png` continua indo para o backend em vez de cair na regra de
    # assets estáticos.
    location ^~ /api/ {
        # O endereço do backend é re-resolvido a cada `valid=10s`, e não uma
        # única vez na subida do container.
        #
        # Isto é o que evita o modo de falha silencioso da plataforma: escrever
        # o hostname direto no `proxy_pass` faz o nginx resolvê-lo no parse da
        # configuração e guardar o IP enquanto o processo viver. Quando o
        # backend é reimplantado ele ganha um IP novo na rede privada, o nginx
        # segue discando o IP antigo — que não responde mais — e toda chamada
        # de /api/ morre em 504 com "upstream timed out while connecting",
        # sem nunca alcançar o backend (por isso não há log do outro lado).
        # Só um restart do frontend limpava o cache, até a próxima vez.
        #
        # Passar o destino por variável obriga o nginx a consultar o resolver a
        # cada requisição, respeitando o TTL abaixo. O resolver vem do
        # /etc/resolv.conf do próprio container, injetado na inicialização —
        # não dá para fixar o IP do DNS, ele muda conforme a plataforma.
        resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
        resolver_timeout 5s;

        set $backend "${BACKEND_URL}";

        # $request_uri preserva o caminho e a query string originais. Como este
        # location casa /api/ e o backend também serve sob /api/, o caminho vai
        # inteiro, sem reescrita.
        proxy_pass $backend$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout  30s;
        proxy_connect_timeout 10s;

        # Fallback: só preenche quando o nginx gera a resposta sozinho
        # (502/504 com o backend fora do ar). Se o backend respondeu, os
        # valores mapeados ficam vazios e nada é adicionado — as respostas
        # de /api/ seguem carregando só o que o Spring Security define.
        add_header X-Frame-Options        $fallback_x_frame_options always;
        add_header X-Content-Type-Options $fallback_x_content_type_options always;
        add_header Referrer-Policy        $fallback_referrer_policy always;
    }

    # Suprimir log de favicon 404
    location = /favicon.ico {
        log_not_found off;
        access_log off;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
